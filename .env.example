# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env wird nie ins Repository übertragen.
#
# Alle Verbindungen lassen sich auch in der Oberfläche unter Einstellungen eintragen.
# Was dort gespeichert ist, hat Vorrang vor den Werten hier.

# Plex
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=

# Telegram (Bot-Token von @BotFather, Chat-ID des Empfängers)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Seerr, für die Merklisten der Benutzer (API-Key: Seerr → Einstellungen → Allgemein)
SEERR_URL=http://192.168.1.10:5055
SEERR_API_KEY=

# TMDB, für „Was kommt“: Neustarts im Kino und bei den Streaminganbietern (kostenloser Schlüssel von themoviedb.org)
TMDB_API_KEY=

# Tautulli, nur für den einmaligen Import alter Wiedergaben (API-Key: Tautulli → Settings → Web Interface)
TAUTULLI_URL=
TAUTULLI_API_KEY=

# Tracearr, ebenfalls nur für den einmaligen Import (API-Key: Settings → General)
TRACEARR_URL=
TRACEARR_API_KEY=

# Radarr und Sonarr, um zu sehen, was dort noch verwaltet wird (API-Key: Settings → General)
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
# Zweite Instanzen für 4K, falls vorhanden
RADARR_4K_URL=
RADARR_4K_API_KEY=
SONARR_4K_URL=
SONARR_4K_API_KEY=

# E-Mail für Newsletter und Erinnerungen (Zugangsdaten vom Anbieter des Postfachs, Port 465 oder 587)
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
# Adresse, unter der Blackbriar von außen erreichbar ist; für Links in den Mails
PUBLIC_URL=

# Optional
# Anmeldung abschalten, etwa hinter einem eigenen Zugangsschutz oder wenn du dich ausgesperrt hast
# AUTH=off
PORT=8787
DATA_DIR=./data
# Abstand zwischen zwei Abfragen von Verlauf und Bewertungen, in Sekunden
SYNC_INTERVAL_SECONDS=300
TZ=Europe/Berlin
